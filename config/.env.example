# Copy to config/.env (next to config.yaml) or to .env in the working
# directory. It is loaded automatically; use --env-file PATH (before the
# subcommand) to point elsewhere. Real environment variables, e.g. the
# machine-scope ones from windows/set_machine_env.ps1, take precedence.
# .env is gitignored. Never commit real values.
#
# Plain KEY=VALUE, one per line. No spaces needed around "=". Quotes are
# optional. Only these three names are read; anything else is ignored.
# Paste the key itself after the "=" -- not in quotes with a label.
NESSUS_ACCESS_KEY=
NESSUS_SECRET_KEY=
DRATA_API_KEY=
